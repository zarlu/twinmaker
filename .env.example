# Copy to .env (never committed). These are development defaults, not secrets.

# Which project folder describes this twin (channels, nodes, tasks, simulator).
# Start with an example; after `make init` switch this to `project`.
PROJECT_DIR=examples/water_quality

# Required. Writes (ingest, labels, jobs) need this value in the X-API-Key header.
# Change it before the API is reachable from another machine.
API_KEY=dev-key-change-me

DB_URL=sqlite:///data/twin.db
DATA_DIR=data                    # backtest reports and model artifacts
API_URL=http://localhost:8000    # where the dashboard, simulator and importer find the API
